# Copy to /etc/hostable/cloud.env on the droplet (chmod 600, owner root).
# Never commit the real file.
HOSTABLE_ADMIN_TOKEN=change-me-to-a-long-random-string
# A P-256 private key, base64url (see docs/deploy.md to make one).
HOSTABLE_VAPID_PRIVATE_KEY=
HOSTABLE_VAPID_SUBJECT=mailto:you@example.com
